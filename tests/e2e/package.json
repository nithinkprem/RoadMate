{
  "name": "knive-playwright-framework",
  "version": "1.0.0",
  "description": "Page-Object-Model Playwright E2E automation framework for the Knive roadside-assistance marketplace.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:admin": "playwright test admin-actions",
    "test:customer": "playwright test customer-journey",
    "test:a11y": "playwright test accessibility",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@axe-core/playwright": "^4.10.0",
    "@types/node": "^20.14.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^2.15.1",
    "typescript": "^5.6.0"
  }
}
